{
  "manifest_version": 3,
  "name": "Rabisco — anotar páginas",
  "short_name": "Rabisco",
  "version": "0.2.1",
  "description": "Desenhe, destaque e escreva por cima de qualquer página. Feito para aulas e análises de sites.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rabisco: anotar esta página (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Abrir/fechar o Rabisco nesta aba"
    },
    "toggle-draw": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Ligar/desligar o modo desenho"
    }
  }
}
